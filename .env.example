APP_ENV=production
APP_DEBUG=false
BASE_URL=/

DB_HOST=localhost
DB_PORT=3306
DB_FALLBACK_PORT=3307
DB_NAME=school_admin
DB_FALLBACK_NAME=website_sekolah
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CONNECT_TIMEOUT=3

MAIL_FROM_ADDRESS=no-reply@sd-cahaya-harapan.sch.id
MAIL_FROM_NAME="SD Cahaya Harapan Bekasi"

# Optional: gunakan SMTP agar fitur lupa password benar-benar mengirim email di hosting.
# Kosongkan SMTP_HOST untuk fallback ke mail() PHP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=10
# Optional: simpan runtime file di luar public_html/htdocs saat production.
# Jika kosong, production otomatis memakai folder satu level di atas BASE_PATH.
LOG_DIR=
BACKUP_DIR=
CACHE_DIR=
